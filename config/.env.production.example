# ============================================
# Mirror Leech Telegram Bot - Configuration
# ============================================
# 
# INSTRUCTIONS:
# 1. Copy this file: cp config/.env.production.example config/.env.production
# 2. Update all values with YOUR OWN credentials
# 3. NEVER commit config/.env.production to git
# 4. Keep this template (example) in git - never add real values here

# ============================================
# 🔑 TELEGRAM BOT CONFIGURATION (REQUIRED)
# ============================================

# Get from @BotFather on Telegram
# @BotFather → /newbot → choose a name → get token
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Get from https://my.telegram.org/apps
# Create a new application to get these
TELEGRAM_API=YOUR_API_ID
TELEGRAM_HASH=YOUR_API_HASH

# Your Telegram user ID (get from @userinfobot)
OWNER_ID=YOUR_USER_ID

# Space-separated list of authorized user/group/channel IDs
# Example: AUTHORIZED_CHATS=123456789 987654321
AUTHORIZED_CHATS=

# Optional: Sudo users with admin privileges (space-separated)
SUDO_USERS=

# ============================================
# 🔐 SESSION & CREDENTIALS
# ============================================

# Optional: Pyrogram user session string (for client API access)
# Leave empty to use bot API only
USER_SESSION_STRING=

# Optional: Rclone config path for cloud uploads
RCLONE_CONFIG_PATH=/app/data/rclone.conf

# ============================================
# 📊 DATABASE CONFIGURATION
# ============================================

# MongoDB connection URL (leave empty to disable)
# Format: mongodb://username:password@host:port/
DATABASE_URL=mongodb://mltb-mongodb:27017/

# Encrypt sensitive data in database
DATABASE_ENCRYPTED=true

# Use SSL for MongoDB connection
DATABASE_SSL=false

# ============================================
# 🔴 REDIS CONFIGURATION (Cache & Queue)
# ============================================

# Redis server URL
REDIS_URL=redis://mltb-redis:6379/0

# Secure password for Redis
# Generate via: openssl rand -hex 32
REDIS_PASSWORD=YOUR_SECURE_REDIS_PASSWORD

# ============================================
# 🌐 SERVER & STREAMING
# ============================================

# Domain where your bot is deployed
# Used for generating stream links
BASE_URL=http://your-domain.com

# Port for web server
BASE_URL_PORT=8060

# Enable stream links for files
ENABLE_STREAM_LINKS=true

# Stream link expiration time (in seconds)
# Default: 1800 (30 minutes)
STREAM_LINK_TTL_SECONDS=1800

# ============================================
# 🔒 SECURITY & SSL (Optional)
# ============================================

# Enable HTTPS for web server
ENABLE_HTTPS=false

# Path to SSL certificate (if ENABLE_HTTPS=true)
# Use Let's Encrypt: certbot certonly --standalone -d your-domain.com
SSL_CERT_PATH=/app/certs/cert.pem

# Path to SSL private key
SSL_KEY_PATH=/app/certs/key.pem

# Drop old updates on startup (clear telegram backlog)
DROP_PENDING_UPDATES_ON_STARTUP=true

# ============================================
# 📝 LOGGING & MONITORING
# ============================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log directory
LOG_DIR=data/logs

# Log format: text, json
LOG_FORMAT=json

# Rotate logs when size exceeds (bytes)
# 52428800 = 50MB
LOG_ROTATION_SIZE=52428800

# Keep this many backup log files
LOG_ROTATION_BACKUPS=10

# Delete logs older than this many days
LOG_RETENTION_DAYS=30

# ============================================
# 📨 ALERTS & NOTIFICATIONS
# ============================================

# Enable alerts for errors/warnings
ENABLE_ALERTS=true

# Chat ID to send alerts to (usually your USER_ID or group ID)
TELEGRAM_ALERT_CHAT_ID=

# Only alert for WARNING level or above
ALERT_LOG_LEVEL=WARNING

# ============================================
# ⚡ PERFORMANCE TUNING
# ============================================

# Enable performance logging
ENABLE_PERFORMANCE_LOGGING=true

# Log slow requests (milliseconds)
PERFORMANCE_LOG_THRESHOLD_MS=1000

# Max concurrent file uploads
MAX_CONCURRENT_UPLOADS=5

# Max concurrent downloads
MAX_CONCURRENT_DOWNLOADS=5

# ============================================
# 🔧 DOWNLOAD CLIENTS (Optional)
# ============================================

# Aria2 RPC URL (for magnet/torrent downloads)
# Leave empty to disable
ARIA2_RPC_URL=

# qBittorrent endpoint
# Leave empty to disable
QBITTORRENT_HOST=

# qBittorrent username
QBITTORRENT_USER=

# qBittorrent password
QBITTORRENT_PASS=

# ============================================
# 🌍 CLOUD STORAGE (Optional)
# ============================================

# Google Drive API credentials
GOOGLE_DRIVE_FOLDER_ID=

# Mega account email (for Mega uploads)
MEGA_EMAIL=

# Mega account password
MEGA_PASSWORD=

# ============================================
# 🎬 FEATURES
# ============================================

# Enable automation system
ENABLE_AUTOMATION_SYSTEM=true

# Enable client selection (user chooses upload destination)
ENABLE_CLIENT_SELECTION=true

# Enable smart thumbnails
ENABLE_SMART_THUMBNAILS=false

# Enable auto-recovery on errors
ENABLE_AUTO_RECOVERY=true

# Enable worker autoscaling
ENABLE_WORKER_AUTOSCALER=false

# ============================================
# 📍 DOWNLOAD PREFERENCES
# ============================================

# Default download directory (relative to app container)
DOWNLOAD_DIR=/app/downloads

# Max file size for stream link (MB)
# Telegram Bot API limit is 20MB
MAX_STREAM_FILE_SIZE=20

# Default upload destination
# Options: gdrive, mega, rclone, telegram
DEFAULT_UPLOAD_DESTINATION=gdrive

# ============================================
# 🔗 PROXY (Optional)
# ============================================

# Telegram proxy for accessing Telegram in restricted regions
# Leave empty to disable
TG_PROXY=

# ============================================
# 🎛️ ADVANCED (Usually don't change)
# ============================================

# Bot polling timeout
BOT_POLLING_TIMEOUT=10

# Max message cache size
MAX_MESSAGE_CACHE_SIZE=15000

# Retry failed requests this many times
MAX_RETRIES=3

# Wait this long before retrying (seconds)
RETRY_DELAY=5

# ============================================
# 📌 IMPORTANT NOTES
# ============================================

# 1. NEVER share this file if it contains real credentials
# 2. NEVER commit this file to git if it contains real values
# 3. Use environment variable substitution for sensitive values
# 4. For production, use a secrets manager (AWS Secrets Manager, etc)
# 5. Rotate credentials regularly
# 6. Keep backups of working configurations
# 7. Test in staging before production deployment

