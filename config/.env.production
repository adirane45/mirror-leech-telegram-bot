LOG_DIR=data/logs
LOG_FORMAT=json
LOG_ROTATION_SIZE=52428800  # 50MB
LOG_ROTATION_BACKUPS=10
LOG_RETENTION_DAYS=30

# Alert Configuration
TELEGRAM_ALERT_CHAT_ID=YOUR_ALERT_CHAT_ID
ENABLE_ALERTS=true
ALERT_LOG_LEVEL=WARNING
ALERT_BATCH_SIZE=5
ALERT_BATCH_TIMEOUT=30

# Performance Monitoring
ENABLE_PERFORMANCE_LOGGING=true
PERFORMANCE_LOG_THRESHOLD_MS=1000
ENABLE_REQUEST_TRACKING=true
REQUEST_ID_HEADER=X-Request-ID

# Prometheus Metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
PROMETHEUS_SCRAPE_INTERVAL=15

# ============================================
# Session & Token Security
# ============================================
SESSION_ENCRYPTION_KEY=GENERATE_32_CHAR_HEX_KEY_HERE
API_TOKEN_EXPIRY=3600
REFRESH_TOKEN_EXPIRY=86400

# ============================================
# File Upload Security
# ============================================
MAX_UPLOAD_SIZE=2147483648
ALLOWED_UPLOAD_TYPES=jpg,png,pdf,zip,rar,7z
SCAN_FILES_ON_UPLOAD=true

# ============================================
# Network Security
# ============================================
ENABLE_HTTPS=false
ALLOWED_DOMAINS=localhost,yourdomain.com
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ============================================
# Advanced: Proxy & Tor Support (FOR 403 ERRORS)
# ============================================
# Enable Tor for rotating IP to bypass rate limiting/blocking
ENABLE_TOR=false
TOR_PROXY_URL=socks5://mltb-tor:9050

# Alternative: Use external SOCKS5 proxy
USE_PROXY=false
PROXY_URL=

# Tor service hosts (for Docker)
TOR_HOST=mltb-tor
TOR_PORT=9050
TOR_CONTROL_PORT=9051

