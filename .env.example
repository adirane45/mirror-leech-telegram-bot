# ============================================
# Mirror-Leech Telegram Bot Configuration
# ============================================
# Copy this file to config/.env.production and fill in actual values

# ============================================
# Telegram Bot Configuration
# ============================================
BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_API=YOUR_API_ID
TELEGRAM_HASH=YOUR_API_HASH
OWNER_ID=YOUR_USER_ID
AUTHORIZED_CHATS=YOUR_USER_ID
SUDO_USERS=YOUR_USER_ID
USER_SESSION_STRING=

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=mongodb://localhost:27017/mltb
DATABASE_ENCRYPTED=true
DATABASE_SSL=false

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=YOUR_REDIS_PASSWORD
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ============================================
# Download Clients
# ============================================
ARIA2_HOST=localhost
ARIA2_PORT=6800
ARIA2_SECRET=YOUR_ARIA2_SECRET
RPC_SECRET=YOUR_ARIA2_SECRET

QB_HOST=localhost
QB_PORT=8090
QB_USERNAME=admin
QB_PASSWORD=mltbmltb

# ============================================
# Cloud Storage & API Keys
# ============================================
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

USE_SERVICE_ACCOUNT=false
SERVICE_ACCOUNT_INDEX=0

# ============================================
# Monitoring & Observables
# ============================================
ENABLE_PROMETHEUS=true
ENABLE_OPENTELEMETRY=false

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_PORT=9090

# ============================================
# Cache & Performance
# ============================================
DASHBOARD_CACHE_TTL=2
CACHE_EXPIRY=3600

# ============================================
# Logging & Debugging
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=detailed

# ============================================
# Feature Flags
# ============================================
ENABLE_PHASE5=false
ENABLE_AUTOMATION_SYSTEM=true
ENABLE_CLIENT_SELECTION=true
ENABLE_AUTO_RECOVERY=true
ENABLE_WORKER_AUTOSCALER=true
ENABLE_SMART_THUMBNAILS=true
DROP_PENDING_UPDATES_ON_STARTUP=true

# ============================================
# Advanced Settings
# ============================================
CMD_SUFFIX=
COMMANDS_CLEAR_DELAY=30
MAX_FILE_SIZE=2097152000
TORRENT_TIMEOUT=0
CLONE_DEPTH=0
USER_TRANSMISSION_TIMEOUT=3600

# ============================================
# Deployment & Environment
# ============================================
ENVIRONMENT=production
BASE_URL_PORT=8060

# ============================================
# Advanced: Proxy & Tor Support (FOR 403 ERRORS)
# ============================================
# Enable Tor to rotate IP (fixes geo-blocking & 403 errors)
ENABLE_TOR=false
TOR_PROXY_URL=socks5://127.0.0.1:9050

# Or use any SOCKS5/HTTP proxy server
USE_PROXY=false
PROXY_URL=

# Tor connection settings
TOR_HOST=127.0.0.1
TOR_PORT=9050
TOR_CONTROL_PORT=9051
