# Bandit security scanning configuration
# Reference: https://bandit.readthedocs.io/en/latest/config.html

[bandit]
# Exclude test files and safe directories
exclude_dirs = [
    'tests',
    'deployment',
    '.git',
    '__pycache__',
    'venv',
    '.venv',
]

# Tests to run
tests = [
    'B101',  # Assert used (often in tests)
    'B102',  # exec used
    'B103',  # Set temporary file permissions
    'B104',  # Binding to all interfaces
    'B105',  # Hardcoded password_
    'B106',  # Hardcoded temp_folder
    'B107',  # Hard-coded temp_folder
    'B108',  # Hard-coded /tmp
    'B110',  # try/except pass
    'B112',  # try/except pass (bare)
    'B201',  # Flask debug on
    'B301',  # Pickle
    'B302',  # Marshal
    'B303',  # MD5
    'B304',  # Cipher
    'B305',  # Cipher
    'B306',  # Temp file
    'B307',  # eval
    'B308',  # Mark safe
    'B309',  # HTTPSConnection
    'B310',  # urllib urlopen
    'B311',  # Random for security
    'B312',  # Telnet
    'B313',  # XML
    'B314',  # XML
    'B315',  # XML
    'B316',  # XML
    'B317',  # YAML load
    'B318',  # XML
    'B319',  # XML
    'B320',  # XML
    'B321',  # FTP
    'B322',  # Unverified SSL
    'B323',  # Unverified SSL
    'B324',  # Hash function
    'B325',  # Temp file
]

# Skips - tests to skip (if needed)
skips = [
    # Add test numbers to skip, e.g., 'B101', 'B601'
]
