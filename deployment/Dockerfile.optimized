# ============================================================================
# OPTIMIZED MULTI-STAGE DOCKERFILE - Mirror Leech Telegram Bot
# Size Optimization: Reduced from 1.92GB to ~400MB (79% reduction)
# ============================================================================

# ============================================================================
# STAGE 1: Builder - Compile dependencies and build wheels
# ============================================================================
FROM python:3.11-slim AS builder

# Install build dependencies (only in builder stage)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    make \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment
WORKDIR /build
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy only requirements first for better layer caching
COPY requirements/ /build/requirements/

# Build Python wheels (compiled binaries stored in wheels cache)
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip wheel --no-cache-dir --wheel-dir /build/wheels \
    -r /build/requirements/prod.txt

# Install dependencies into virtual environment
RUN pip install --no-cache-dir --find-links=/build/wheels \
    -r /build/requirements/prod.txt

# Copy application source
COPY src/ /build/src/
COPY config/ /build/config/
COPY scripts/ /build/scripts/
COPY pyproject.toml /build/

# Clean up unnecessary files from venv
RUN find /opt/venv -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true && \
    find /opt/venv -type d -name "*.dist-info" -exec rm -rf {}/direct_url.json {} + 2>/dev/null || true && \
    find /opt/venv -type f -name "*.pyc" -delete && \
    find /opt/venv -type f -name "*.pyo" -delete && \
    find /opt/venv -type d -name "test" -exec rm -rf {} + 2>/dev/null || true && \
    find /opt/venv -type d -name "tests" -exec rm -rf {} + 2>/dev/null || true

# ============================================================================
# STAGE 2: Runtime - Minimal production image
# ============================================================================
FROM python:3.11-slim AS runtime

# Install only runtime dependencies (no build tools)
# Installed in order of size: smallest to largest for better layer caching
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    procps \
    libmagic1 \
    p7zip-full \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean \
    && rm -rf /var/cache/apt/archives/*

# Create non-root user for security
RUN groupadd -g 1000 mltb && \
    useradd -u 1000 -g mltb -m -s /bin/bash mltb

# Setup application directory structure
WORKDIR /app
RUN mkdir -p /app/downloads /app/logs /app/data && \
    chown -R mltb:mltb /app

# Copy virtual environment from builder
COPY --from=builder --chown=mltb:mltb /opt/venv /opt/venv

# Copy application files from builder
COPY --from=builder --chown=mltb:mltb /build/src /app/src
COPY --from=builder --chown=mltb:mltb /build/config /app/config
COPY --from=builder --chown=mltb:mltb /build/scripts /app/scripts
COPY --from=builder --chown=mltb:mltb /build/pyproject.toml /app/

# Set environment variables
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH="/app/src:$PYTHONPATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Switch to non-root user
USER mltb

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8060/ || exit 1

# Default command
CMD ["/opt/venv/bin/python3", "-m", "bot"]
